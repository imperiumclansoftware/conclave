<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Conclave for Windows 11: WinUI 3, unpackaged and self-contained (no runtime to install, no
    certificate needed), installed by the Inno Setup installer (../../installer).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Conclave.Desktop</RootNamespace>
    <AssemblyName>Conclave</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\conclave.ico</ApplicationIcon>
    <!-- The interface is written in C#: the entry point is Program.Main -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Lets the code be compiled (checked) on Linux too; packaging needs Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI and what it needs (WebView2, notifications, app lifecycle), without the AI/ML parts -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- WinUI 2.3.9 asks for 2.1.8, which was never published: the next one, explicitly -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <ProjectReference Include="..\Conclave.Desktop.Core\Conclave.Desktop.Core.csproj" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The application's resource index (Conclave.pri, which merges the WinUI themes) is written
    straight into the output folder, so "dotnet publish" leaves it out for an unpackaged app:
    without it, WinUI cannot find its themes and the application closes at launch.
  -->
  <Target Name="PublishProjectPriFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <Error Condition="'$(AppxGeneratePriEnabled)' != 'false' and !Exists('$(ProjectPriFullPath)')"
           Text="Fichier de ressources introuvable : $(ProjectPriFullPath)" />
    <ItemGroup Condition="Exists('$(ProjectPriFullPath)')">
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             RelativePath="$(ProjectPriFileName)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
