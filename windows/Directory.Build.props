<Project>
  <!-- Shared by the projects of the Windows application -->
  <PropertyGroup>
    <!-- Version of the application: dotnet publish -p:Version=0.4.0 -->
    <Version Condition="'$(Version)' == ''">0.4.0</Version>
    <Company>Imperium Clan Software</Company>
    <Product>Conclave</Product>
    <Copyright>Imperium Clan Software, licence MIT</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
