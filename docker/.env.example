# Conclave: copy to .env next to compose.yaml (or enter these variables in a Portainer stack).
# Generate each secret with: openssl rand -hex 32

# Address at which the members reach Conclave (scheme, host and port, without trailing slash)
CONCLAVE_URL=http://192.168.1.10:8080
# Port published on the host (must match CONCLAVE_URL)
CONCLAVE_PORT=8080
# Image tag (latest, or a version such as 0.1.0)
CONCLAVE_VERSION=latest
# Time zone of the dates in the e-mails (optional)
APP_TIMEZONE=Europe/Paris

# Secrets: keep them; changing APP_SECRET makes the secrets saved in the administration unreadable
APP_SECRET=
JWT_PASSPHRASE=
MERCURE_JWT_SECRET=
POSTGRES_PASSWORD=
