# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=!ChangeMe!
###< lexik/jwt-authentication-bundle ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=http://localhost:3000/.well-known/mercure
# The URL of the Mercure hub used by the browser (through the Angular dev proxy). Not named
# MERCURE_PUBLIC_URL on purpose: the Symfony CLI overrides that one with the Docker hub URL.
MERCURE_BROWSER_URL=http://localhost:4200/.well-known/mercure
# The secret used to sign the JWTs (shared with the hub, see compose.yaml)
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
# "iss" claim of the minted tokens, trusted by the hub
MERCURE_ISSUER=http://localhost:8000
# "aud" claim of the minted tokens, pinned as the hub's resource identifier
MERCURE_AUDIENCE=http://localhost:4200/.well-known/mercure
# Prefix of the topics (one private topic per user)
MERCURE_TOPIC_PREFIX=https://clan-app.local
###< symfony/mercure-bundle ###

###> game catalog ###
# Free API key from https://rawg.io/apidocs: enables all platforms (consoles included).
# Without it, games are searched on the Steam store (PC games only).
RAWG_API_KEY=
###< game catalog ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> discord ###
# Discord application (https://discord.com/developers/applications): OAuth2 client and bot.
# Enable "Presence Intent" (Bot > Privileged Gateway Intents) and add DISCORD_REDIRECT_URI to
# OAuth2 > Redirects. Leave empty to disable the Discord integration.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Frontend route receiving the OAuth2 response, e.g. https://example.com/discord/callback
DISCORD_REDIRECT_URI=
###< discord ###

###> symfony/mailer ###
MAILER_DSN=null://null
# Sender of the e-mails and public URL of the app (used in e-mail links); both can be set in the administration
MAILER_FROM=
APP_PUBLIC_URL=
# Time zone of the dates written in the e-mails (the server runs in UTC)
APP_TIMEZONE=Europe/Paris
###< symfony/mailer ###

###> avenger ###
# Ticket widget of the Avenger app that follows the project (menu of the account > « Signaler un
# problème »): address of Avenger, e.g. https://avenger.example.org. Empty: no menu entry.
AVENGER_URL=
# Product of Avenger that receives the tickets
AVENGER_PRODUCT=conclave
###< avenger ###
