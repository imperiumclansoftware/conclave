{% extends 'emails/base.html.twig' %}
{% block content %}
  <p>
    {% if event.createdBy %}<strong>{{ event.createdBy.displayName }}</strong> organise{% else %}Un événement est organisé{% endif %}
    sur un de vos jeux : <strong>{{ event.game.name }}</strong> sur {{ event.gamePlatform.label }}.
  </p>
  <p style="margin:16px 0;padding:12px 16px;border-left:3px solid #a3171d;background:#f6eedb;">
    <strong>{{ event.title }}</strong><br>
    {{ event.type.label }} · {{ when }}
    {% if event.maxParticipants %}<br>{{ event.participants|length }} / {{ event.maxParticipants }} places prises{% endif %}
  </p>
  {% if event.description %}<p>{{ event.description|nl2br }}</p>{% endif %}
  {% if link %}{% include 'emails/_button.html.twig' with { label: 'Voir l\'événement et s\'inscrire' } %}{% endif %}
  <p style="color:#6b5a45;font-size:13px;">
    Vous recevez cet e-mail parce que ce jeu figure dans votre ludothèque sur cette plateforme.
    {% if settingsLink %}<a href="{{ settingsLink }}" style="color:#6b5a45;">Ne plus recevoir ces e-mails</a>{% else %}Vous pouvez désactiver ces e-mails dans votre profil, onglet Notifications.{% endif %}
  </p>
{% endblock %}
