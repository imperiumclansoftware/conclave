<!doctype html>
<html lang="fr">
<body style="margin:0;padding:24px;background:#ece2cb;font-family:Georgia,'Times New Roman',serif;color:#231c15;">
  <table role="presentation" width="100%" style="max-width:560px;margin:0 auto;background:#fbf7ee;border:1px solid #c9b48e;border-radius:6px;">
    <tr>
      <td style="padding:20px 28px;border-bottom:3px solid #a3171d;">
        <strong style="font-size:20px;letter-spacing:1px;text-transform:uppercase;">{{ clanName }}</strong>
      </td>
    </tr>
    <tr>
      <td style="padding:24px 28px;font-size:16px;line-height:1.5;">
        <p>Bonjour {{ user.displayName }},</p>
        {% block content %}{% endblock %}
      </td>
    </tr>
    <tr>
      <td style="padding:14px 28px;border-top:1px solid #c9b48e;font-size:12px;color:#6b5a45;">
        E-mail automatique envoyé par Conclave pour {{ clanName }}, merci de ne pas y répondre.
      </td>
    </tr>
  </table>
</body>
</html>
